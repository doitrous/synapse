<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".SynapseApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Synapse">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Synapse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Disable WorkManager's default (androidx.startup) initializer: it would build a
          Configuration before Hilt has injected SynapseApp.workerFactory. WorkManager is
          initialized on-demand instead, from SynapseApp.onCreate, once injection is done.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Below Android 13, AppCompat has no OS-level per-app-language store to piggyback
          on, so it keeps its own (a SharedPreferences file) instead — but only once this
          override turns that on. Without it, setApplicationLocales(...) would still change
          the running process's locale, but a fresh process (app restart, task kill) would
          come back in the previous locale until synapse-lang is re-applied.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>

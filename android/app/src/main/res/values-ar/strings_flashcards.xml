<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- feature/flashcards — Arabic strings. Fresh Modern Standard Arabic — neither the iOS
         ArabicStrings.swift nor the web i18n-ar.ts carry a flashcards-deck vocabulary of their
         own (their "Deck"/"عرض تقديمي" entries refer to a library presentation, a different
         concept), except nav_flashcards itself, already "البطاقات التعليمية" in strings.xml,
         whose "بطاقة" (card) / "مجموعة" (deck) vocabulary this file follows. -->

    <!-- DeckListScreen. -->
    <string name="flashcards_loading">جارٍ التحميل…</string>
    <string name="flashcards_your_decks_title">مجموعاتك</string>
    <string name="flashcards_new_deck">مجموعة جديدة</string>
    <string name="flashcards_no_own_decks">لم تُنشئ أي مجموعة بعد.</string>
    <string name="flashcards_provided_decks_title">المجموعات المُقدَّمة</string>
    <string name="flashcards_no_provided_decks_yet">تظهر المجموعات المنشورة هنا فور إصدارها.</string>
    <string name="flashcards_provided_chip">مُقدَّمة</string>
    <string name="flashcards_edit_deck_description">إضافة البطاقات وتعديلها</string>
    <string name="flashcards_delete_deck_description">حذف المجموعة</string>
    <string name="flashcards_study_button">ذاكِر</string>

    <!-- "بطاقة" (card) is feminine. -->
    <plurals name="flashcards_cards_count">
        <item quantity="zero">لا بطاقات</item>
        <item quantity="one">بطاقة واحدة</item>
        <item quantity="two">بطاقتان</item>
        <item quantity="few">%1$d بطاقات</item>
        <item quantity="many">%1$d بطاقة</item>
        <item quantity="other">%1$d بطاقة</item>
    </plurals>

    <!-- "مستحقة" agrees with the implicit feminine "بطاقة". -->
    <plurals name="flashcards_due_count">
        <item quantity="zero">لا شيء مستحق</item>
        <item quantity="one">واحدة مستحقة</item>
        <item quantity="two">اثنتان مستحقتان</item>
        <item quantity="few">%1$d مستحقة</item>
        <item quantity="many">%1$d مستحقة</item>
        <item quantity="other">%1$d مستحقة</item>
    </plurals>

    <!-- "جديدة" agrees with the implicit feminine "بطاقة". -->
    <plurals name="flashcards_new_count">
        <item quantity="zero">لا شيء جديد</item>
        <item quantity="one">واحدة جديدة</item>
        <item quantity="two">اثنتان جديدتان</item>

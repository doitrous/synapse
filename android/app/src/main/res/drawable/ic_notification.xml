<!-- res/drawable/ic_notification.xml -->
<!-- Status-bar/action icon for the focus-timer notification: a plain filled
     disc, echoing the launcher mark's dot. Android auto-tints notification
     icons to a single colour on API 21+, so only the alpha shape matters. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z" />
</vector>

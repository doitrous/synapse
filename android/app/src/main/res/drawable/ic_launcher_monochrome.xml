  geometry as ic_launcher_foreground, drawn in a single colour — the launcher
  re-tints it to the user's theme, using only the shape's coverage.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="4"
        android:translateY="4">
        <path
            android:pathData="M84,50 A34,34 0 1 1 16,50 A34,34 0 1 1 84,50"
            android:strokeColor="#000000"
            android:strokeWidth="8"
            android:strokeLineCap="round"

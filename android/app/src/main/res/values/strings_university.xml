         `unchanged`, `pending_exists`, per UniversityApi.kt / enrollmentChanges.js)
         stay in English on the wire; these are only the display text. -->
    <string name="university_refusal_invalid_field">That field isn\'t recognized.</string>
    <string name="university_refusal_requested_value_required">Enter the value you\'re requesting.</string>
    <string name="university_refusal_reason_required">Say why in at least 12 characters.</string>

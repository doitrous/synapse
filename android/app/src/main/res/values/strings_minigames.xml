    <string name="minigames_spotter_title">Spotter</string>
    <string name="minigames_termmatch_title">Term Match</string>
    <string name="minigames_clinicalsequence_title">Clinical Sequence</string>
    <string name="minigames_mechanismchain_title">Mechanism Chain</string>
    <string name="minigames_redflagsort_title">Red Flag Sort</string>

    <!-- Hub card descriptions (MinigamesHub.kt — distinct wording from the in-game subtitle below). -->
    <string name="minigames_termgrid_hub_description">Crossword practice from the published glossary.</string>
    <string name="minigames_spotter_hub_description">Spot the glossary term from its definition under time pressure.</string>
    <string name="minigames_termmatch_hub_description">Match fixed terms to shuffled definitions or Arabic translations.</string>
    <string name="minigames_clinicalsequence_hub_description">Order reviewed procedural or clinical steps.</string>
    <string name="minigames_mechanismchain_hub_description">Rebuild reviewed cause-to-effect chains.</string>
    <string name="minigames_redflagsort_hub_description">Classify reviewed findings by escalation level.</string>


    <string name="minigames_hub_disclaimer">Medicine game facts come from reviewed local packs or published content. The app can shuffle and score them, but it does not invent facts during play.</string>

    <plurals name="minigames_hub_packs_ready">
        <item quantity="one">%1$d authored pack ready</item>
        <item quantity="other">%1$d authored packs ready</item>
    </plurals>

    <!-- Hub catalog badges (MinigameEntry.badge). -->
    <string name="minigames_badge_glossary">Glossary</string>
    <string name="minigames_badge_authored_pack">Authored pack</string>

    <!-- Per-game titles — shared by the hub card (MinigamesHub.kt) and the in-game header (GameHeader). -->

    <string name="minigames_termgrid_description">A crossword built from the glossary — fill in each term from its definition.</string>
    <string name="minigames_spotter_description">A term\'s definition is shown but not its name — spot it from four options before moving on.</string>
    <string name="minigames_termmatch_description">Match each term to its Arabic translation or its definition — pick two tiles at a time.</string>
    <string name="minigames_clinicalsequence_description">Order authored clinical or procedural steps.</string>
    <string name="minigames_mechanismchain_description">Order authored cause-to-effect relationships.</string>
    <string name="minigames_redflagsort_description">Classify authored urgent findings without generated facts.</string>


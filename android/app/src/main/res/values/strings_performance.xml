<resources>
    <!-- feature/performance — Performance tab: the student's own study charts
         (accuracy, coverage, streak, heatmap) plus the cohort leaderboard
         (EN/AR). Breakdown group keys (subject id, difficulty band, surface)
         and leaderboard scope/username are data from the attempt log and the
         server and are never localized here — only the surrounding UI copy is. -->

    <string name="performance_title">Performance</string>
    <string name="performance_tab_personal">Personal progress</string>
    <string name="performance_tab_leaders">Top performers</string>

    <string name="performance_empty_message">Nothing measured yet. Answer some questions and your accuracy, coverage and streak appear here.</string>

    <!-- Personal progress section titles. -->
    <string name="performance_section_when_you_study">When you study</string>
    <string name="performance_section_by_subject">Accuracy by subject</string>
    <string name="performance_section_by_difficulty">Accuracy by difficulty</string>
    <string name="performance_section_by_surface">Where the work went</string>

    <!-- Headline KPI tiles. -->
    <string name="performance_kpi_accuracy_label">Accuracy</string>
    <string name="performance_accuracy_percent">%1$d%%</string>

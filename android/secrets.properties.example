# Copy to secrets.properties and fill in. secrets.properties is gitignored.
# Strip the scheme from the hosts (an xcconfig-style // would be a comment; we
# add https:// back in AppConfig). Use the Supabase publishable/anon key,
# never the service-role key.
API_HOST=synapse.doitrous.com
SUPABASE_HOST=your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

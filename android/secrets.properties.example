# Copy to secrets.properties and fill in. That file is gitignored.
# Supabase dashboard → Project Settings → API.
# Host only, no scheme and no trailing slash.
SUPABASE_HOST=abcdefgh.supabase.co
# The publishable "anon" key. NEVER the service role key — it bypasses
# every row-level security policy and must not ship in a client.
SUPABASE_ANON_KEY=eyJhbGciOi...
API_BASE_URL=https://api.example.com

# Synapse API — server env. Set these in Coolify (never in the browser build).
PORT=8080

# MariaDB — either DATABASE_URL, or the discrete DB_* vars.
# DATABASE_URL=mysql://synapsedb:PASSWORD@DB_HOST:8823/synapsedb
DB_HOST=
DB_PORT=8823
DB_NAME=synapsedb
DB_USER=synapsedb
DB_PASSWORD=

# Resend — sending-only key here (least privilege).
RESEND_API_KEY=
MAIL_FROM=synapse@mail.doitrous.com

# Shared bearer token the SPA sends (until real auth). Match VITE_API_TOKEN in the app.
API_BEARER=

# Comma-separated allowed origins for CORS (your SPA URL). Omit to allow all (dev).
CORS_ORIGIN=

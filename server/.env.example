# Synapse API — server env. Set these in Coolify (never in the browser build).
PORT=8080

# MariaDB — either DATABASE_URL, or the discrete DB_* vars.
# DATABASE_URL=mysql://synapsedb:PASSWORD@DB_HOST:8823/synapsedb
DB_HOST=
DB_PORT=8823
DB_NAME=synapsedb
DB_USER=synapsedb
DB_PASSWORD=

# Resend — sending-only key here (least privilege).
RESEND_API_KEY=
MAIL_FROM=synapse@mail.doitrous.com

# Supabase Auth JWT verification. URL is server configuration, not a secret.
SUPABASE_URL=https://your-project.supabase.co

# Temporary owner preview. Keep true until the owner explicitly removes it.
# Temporary owner access key. It is entered at runtime on /login and must never
# be exposed as a VITE_ build variable.
AUTH_BYPASS_ENABLED=true
API_BEARER=

# Comma-separated allowed origins for CORS (your SPA URL). Omit to allow all (dev).
CORS_ORIGIN=

# Managed teaching media (images, audio and video). Files are uploaded in
# bounded chunks; keep the chunk value below reverse-proxy request limits.
MEDIA_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_BYTES=104857600
MEDIA_CHUNK_MAX_BYTES=8388608
MEDIA_CHUNKED_MAX_BYTES=2147483648
MEDIA_UPLOAD_MAX_AGE_HOURS=24
# Required when the API runs on multiple replicas so signed playback URLs work
# regardless of which replica receives the video/audio Range request.
MEDIA_PLAYBACK_SECRET=

# Finding friends through Facebook. Off unless this is exactly "true": the
# matching cannot work until Meta approves the app, and the client hides the
# control behind VITE_FEATURE_FACEBOOK_FRIENDS for the same reason.
FEATURE_FACEBOOK_FRIENDS=false

# Signs Meta's data-deletion callback. Without it that endpoint refuses every
# request rather than trusting one — an unconfigured integration must reject,
# never accept.
FACEBOOK_APP_SECRET=

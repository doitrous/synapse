# Synapse API — server env. Set these in Coolify (never in the browser build).
PORT=8080

# MariaDB — either DATABASE_URL, or the discrete DB_* vars.
# DATABASE_URL=mysql://synapsedb:PASSWORD@DB_HOST:8823/synapsedb
DB_HOST=
DB_PORT=8823
DB_NAME=synapsedb
DB_USER=synapsedb
DB_PASSWORD=

# Resend — sending-only key here (least privilege).
RESEND_API_KEY=
MAIL_FROM=synapse@mail.doitrous.com

# Supabase Auth JWT verification. URL is server configuration, not a secret.
SUPABASE_URL=https://your-project.supabase.co

# Temporary owner preview. Keep true until the owner explicitly removes it.
# Temporary owner access key. It is entered at runtime on /login and must never
# be exposed as a VITE_ build variable.
AUTH_BYPASS_ENABLED=true
API_BEARER=

# Comma-separated allowed origins for CORS (your SPA URL). Omit to allow all (dev).
CORS_ORIGIN=

# Shared secret for the seo-hub receiver (POST /api/articles). Bearer-checked
# with a timing-safe comparison; see routes/seoArticles.js. Must match the
# secret configured for this site's profile in the hub.
SEO_HUB_SECRET=

# Managed teaching media (images, audio and video). Files are uploaded in
# bounded chunks; keep the chunk value below reverse-proxy request limits.
MEDIA_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_BYTES=104857600
MEDIA_CHUNK_MAX_BYTES=8388608
MEDIA_CHUNKED_MAX_BYTES=2147483648
MEDIA_UPLOAD_MAX_AGE_HOURS=24
# Required when the API runs on multiple replicas so signed playback URLs work
# regardless of which replica receives the video/audio Range request.
MEDIA_PLAYBACK_SECRET=

# Finding friends through Facebook. Off unless this is exactly "true": the
# matching cannot work until Meta approves the app, and the client hides the
# control behind VITE_FEATURE_FACEBOOK_FRIENDS for the same reason.

# Signs Meta's data-deletion callback. Without it that endpoint refuses every
# request rather than trusting one — an unconfigured integration must reject,
# never accept.

# Facebook friend matching (server) — see docs/facebook-connect-setup.md
# Both required to turn the feature on; either missing keeps /api/friends/facebook/* dark.
FEATURE_FACEBOOK_FRIENDS=
FACEBOOK_APP_SECRET=

# Study room voice (mediasoup SFU) — see docs/rooms-voice.md.
# The signalling socket (/api/rooms/ws) needs none of this and works without it;
# these decide whether audio can actually reach anybody.
#
# SFU_ANNOUNCED_IP is the PUBLIC address other people's browsers dial. Unset, the
# room only connects on the server host itself — voice will look broken for
# everyone. There is deliberately no default: a guess would be wrong.
SFU_ANNOUNCED_IP=
SFU_LISTEN_IP=0.0.0.0
# The UDP/TCP range the media itself uses. Open it on the host AND in Coolify.
# Four ports per member in voice, so 401 ports is about a hundred speakers.
SFU_RTC_MIN_PORT=40000
SFU_RTC_MAX_PORT=40400

# TURN relay. All three or none — a URL with no credential is not a relay, it is
# a connection attempt that fails slowly. Without them clients get STUN only,
# which fails behind symmetric NAT and on many Egyptian mobile networks; a
# coturn server is required for voice to be reliable, not optional.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Mail sender addresses (fromForCategory in mailFrom.js)
MAIL_FROM_TRANSACTIONAL=Nishany <no-reply@mail.nishany.com>
MAIL_FROM_NEWS=Nishany <news@news.nishany.com>
MAIL_FROM_SUPPORT=Nishany <info@nishany.com>

# --- Cookie sessions (sessionStore.js / authRoutes.js) -----------------------
# The key the stored Supabase tokens are sealed with. 32 random bytes, base64:
#   openssl rand -base64 32
# Required in production — the server refuses to start without it. Outside
# production a fixed development key is used and a warning is logged.
# Rotating it signs everybody out; it does not lose any data.
SESSION_ENC_KEY=
# The cookie's Domain. One cookie shared by both portal hostnames. Set it to an
# EMPTY value for plain localhost, which rejects any Domain attribute at all.
# Default: .nishany.com
SESSION_COOKIE_DOMAIN=.nishany.com
# The origins allowed to make a cookie-authenticated write (CSRF allowlist).
# Comma separated, exact origins, no trailing slash.
# Default: https://nishany.com,https://connectadminacademy.nishany.com
PORTAL_ORIGINS=https://nishany.com,https://connectadminacademy.nishany.com
# The publishable (anon) key, for the server's own calls to the Supabase Auth
# API — sign-in, sign-up, recovery, MFA. Not the service-role key: that one is
# SUPABASE_SERVICE_ROLE_KEY and is only used for admin generate_link.
SUPABASE_ANON_KEY=

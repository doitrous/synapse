# Browser-safe build variables. These values identify the Supabase project;
# they are not service-role secrets. Never expose SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key


# Facebook friend matching (client) — see docs/facebook-connect-setup.md
# Both must be set for the "Connect Facebook" button to appear; either missing hides it.
VITE_FEATURE_FACEBOOK_FRIENDS=
VITE_FACEBOOK_APP_ID=

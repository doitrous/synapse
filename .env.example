# UNUSED by the web client since it moved to the server's cookie session: the
# browser no longer talks to Supabase at all. The server needs SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY (plus SUPABASE_SERVICE_ROLE_KEY, never exposed);
# these two only still exist as build args in the Dockerfile.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# Facebook friend matching (client) — see docs/facebook-connect-setup.md
# Both must be set for the "Connect Facebook" button to appear; either missing hides it.
VITE_FEATURE_FACEBOOK_FRIENDS=
VITE_FACEBOOK_APP_ID=


# Web push (client): the VAPID public key, used as applicationServerKey when a
# student subscribes to Question-of-the-Day reminders. Empty = the "Remind me"
# control cannot subscribe.
VITE_VAPID_PUBLIC_KEY=

# --- Server-side environment (NOT VITE_, set on the API server, never committed) ---
# QotD reminders (server):
#   QOTD_REMINDERS_ENABLED=1        # off unless set; gates the daily noon-Cairo dispatch
#   VAPID_PUBLIC_KEY=               # web push; pair with VITE_VAPID_PUBLIC_KEY above
#   VAPID_PRIVATE_KEY=              # web push SECRET — server only
#   VAPID_SUBJECT=mailto:you@domain # web push contact
#   APNS_KEY_P8 / APNS_KEY_ID / APNS_TEAM_ID / APNS_BUNDLE_ID   # iOS push (dormant until set)
#   FCM_SERVICE_ACCOUNT=            # Android push, service-account JSON or base64 (dormant until set)
# See docs/superpowers/specs/2026-08-29-question-of-the-day-reminders-design.md §7.

# Two-host portal split (dev only; production keeps the built-in defaults).
# Both hostnames must resolve to loopback in /etc/hosts — a browser refuses
# `Domain=.localhost`, so the shared session cookie needs real-looking names.
#   127.0.0.1 nishany.test connectadminacademy.nishany.test
VITE_STUDENT_ORIGIN=http://nishany.test:5173
VITE_ADMIN_ORIGIN=http://connectadminacademy.nishany.test:5173

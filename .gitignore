# Personal Claude Code settings (may contain machine-specific permissions)
.claude/settings.local.json

# iOS
# Per-machine Supabase configuration. `Secrets.example.xcconfig` is the
# committed template; the real file is optional-included by Base.xcconfig, so a
# fresh clone still builds and simply reports that it is not configured.
ios/Config/Secrets.xcconfig
ios/build/
ios/DerivedData/
# Swift packages cloned here rather than into DerivedData, so CI can cache
# them at a stable path. Checkouts of other people's repositories — and
# `oxlint` walks into their vendored JavaScript if they are left visible.
ios/.spm/
ios/Synapse.xcodeproj/project.xcworkspace/xcuserdata/
ios/Synapse.xcodeproj/xcuserdata/
# Resolved package versions live in the workspace; keep the pin, drop the noise.
!ios/Synapse.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# The curriculum corpus: 7.4 GB of source PDFs and their extractions.
# It lives in the project so tooling has a stable path, and must never be
# committed — it is source material, not source code.
corpus/

# pagetext.py's per-page cache: rendered pdf pages, page-level readability,
# OCR temp images — regenerable, and not small. Never committed.
# Nothing else writes here — see the incident note on the next line.
scripts/alexandria/pagetext/
# scripts/alexandria/intake/'s own text cache (sourceId -> extracted text, for
# contentTwinOf). Was first written into scripts/alexandria/pagetext/ under a
# colliding filename and overwrote 3,397 of pagetext.py's files on
# 2026-08-22 — moved out to its own directory for good. Never committed.
scripts/alexandria/intake/textcache/

{
  "name": "synapse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "load:students": "node scripts/load-test-students.mjs",
    "preview": "vite preview",
    "og": "node scripts/og/render.mjs",
    "medical:build": "node --experimental-strip-types scripts/build-medical-library-v1.mjs",
    "medical:audit": "node scripts/audit-medical-content-fields.mjs",
    "medical:validate:taxonomy": "node --experimental-strip-types scripts/validate-reviewed-medical-taxonomy.mjs",
    "medical:validate:authoring": "node --experimental-strip-types scripts/validate-authoring-contract.mjs",
    "medical:parity": "node --experimental-strip-types scripts/report-import-field-parity.mjs",
    "medical:inventory": "node --experimental-strip-types scripts/build-system-inventory.mjs",
    "medical:sources": "node --experimental-strip-types scripts/build-system-source-plan.mjs",
    "medical:presence": "node --experimental-strip-types scripts/kasr/check-concept-presence.mjs docs/Kasr-Source-Imports/concept/*.md docs/Kasr-Source-Imports/article/*.md",
    "medical:citations": "node --experimental-strip-types scripts/kasr/check-citations.ts",
    "medical:concept-ids": "node --experimental-strip-types scripts/kasr/check-concept-ids.ts",
  "medical:id-stability": "node --experimental-strip-types scripts/kasr/check-id-stability.ts",
  "medical:duplicate-keys": "node --experimental-strip-types scripts/report-duplicate-keys.ts",
  "medical:snapshot-live": "node scripts/snapshot-live.mjs",
  "medical:snapshot-staleness": "node scripts/snapshot-staleness.mjs",
    "medical:batches-present": "python3 scripts/kasr/check-batches-present.py",
    "medical:batch": "node --experimental-strip-types scripts/validate-content-batch.mjs",
    "medical:simulate": "node --experimental-strip-types scripts/simulate-content-import.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "^9.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}

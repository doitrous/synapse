<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Without this, `registerForRemoteNotifications` fails with "no valid
	  aps-environment entitlement string found for application" and iOS routes
	  no pushes to the app at all — including the silent sync nudge, and
	  including ones delivered locally by `simctl push`.

	  `development` is the sandbox gateway, which is what a debug build and a
	  simulator are provisioned against. Xcode rewrites this to `production`
	  when it exports a release build against a distribution profile, so the
	  value here is the development default rather than a choice made once.

	  A real device additionally needs a provisioning profile with the Push
	  Notifications capability, which needs a paid Apple Developer account.
	  The simulator does not.
	-->
	<key>aps-environment</key>
	<string>development</string>

	<!--
	  Shared container the Focus Timer writes its task list and session into so
	  the NishanyWidgets extension (home-screen widgets + Live Activity) can
	  read them. The extension's own entitlements declare the same group.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.nishany.app</string>
	</array>

	<!--
	  Family Controls — the Focus Timer's strict mode uses this to shield the
	  student's chosen apps for the duration of a strict block (see
	  `Core/ScreenTime/AppBlocker.swift`). This is Apple's most tightly-gated
	  entitlement: it needs a dedicated request approved by Apple, distinct
	  from ordinary capability toggles. That approval is in place for this
	  app; blocking works on a real device provisioned against it. It stays
	  inert — `AuthorizationCenter.shared.requestAuthorization` simply fails —
	  in the simulator, which never grants Screen Time authorization; every
	  `AppBlocker` method no-ops safely in that case.
	-->
	<key>com.apple.developer.family-controls</key>
	<true/>
</dict>
</plist>

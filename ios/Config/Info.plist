<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  This file is MERGED into the Info.plist Xcode generates, rather than
	  replacing it (GENERATE_INFOPLIST_FILE is YES). So the standard keys —
	  CFBundleIdentifier, CFBundleExecutable, versions, orientations — come from
	  build settings and are deliberately absent here. Only what Xcode cannot
	  derive belongs in this file.

	  Build settings below are substituted at build time. The hosts carry no
	  scheme because xcconfig treats `//` as a comment. See Config/Base.xcconfig.
	-->
	<key>NishanyAPIHost</key>
	<string>$(API_HOST)</string>
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>

	<!--
	  The site's own typefaces, converted from the woff2 files it self-hosts
	  rather than downloaded, so the app and the website are the same faces.
	  All four are variable; see Theme.variable() for setting an exact weight.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>SourceSerif4Variable.ttf</string>
		<string>SourceSerif4Variable-Italic.ttf</string>
		<string>GeistVariable.ttf</string>
		<string>GeistMonoVariable.ttf</string>
	</array>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!--
	  Declaring both languages here is what makes iOS offer Arabic in the
	  system language picker and mirror the interface for it.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<!--
	  Waking for a silent push. This is the whole of the app's background
	  work: a `content-available` nudge saying a record changed elsewhere,
	  answered by the ordinary sync refresh. No alert, so no permission.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!--
		  So a study-room voice call keeps running when the phone locks or the
		  student switches away mid-conversation, rather than being cut the moment
		  the app leaves the foreground.
		-->
		<string>audio</string>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  Study-room voice. The microphone is opened only when a student taps
	  "Join voice"; this string is what iOS shows in that one system prompt.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Nishany uses your microphone so you can talk to the others in a study room. It is only on while you are in a room's voice.</string>

	<!--
	  Lets the app start a Focus Timer Live Activity (lock screen + Dynamic
	  Island). The Activity's UI is drawn by the NishanyWidgets extension; this
	  key is what allows the app process to request one.
	-->
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
